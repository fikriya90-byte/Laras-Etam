<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#181a1f" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Kepatihan Studio — Notasi Angka Gamelan Jawa & Musik Barat</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <style>
    :root {
      --bg-top: #181a1f;
      --bg-panel: #20232a;
      --bg-card: #282c34;
      --bg-input: #14161a;
      --bg-desk: #111317;
      --border-main: #333842;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #f59e0b;
    }

    body.theme-light {
      --bg-top: #f8fafc;
      --bg-panel: #ffffff;
      --bg-card: #f1f5f9;
      --bg-input: #e2e8f0;
      --bg-desk: #cbd5e1;
      --border-main: #cbd5e1;
      --text-main: #0f172a;
      --text-muted: #475569;
      --accent: #d97706;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-desk);
      color: var(--text-main);
      margin: 0;
      overflow-x: hidden;
      padding-bottom: env(safe-area-inset-bottom);
    }

    .score-font {
      font-family: 'JetBrains Mono', monospace;
    }

    .sb-top {
      background-color: var(--bg-top);
      border-color: var(--border-main);
      color: var(--text-main);
    }

    .sb-panel {
      background-color: var(--bg-panel);
      border-color: var(--border-main);
      color: var(--text-main);
    }

    .sb-card {
      background-color: var(--bg-card);
      border-color: var(--border-main);
      color: var(--text-main);
    }

    .sb-input {
      background-color: var(--bg-input);
      border-color: var(--border-main);
      color: var(--text-main);
    }

    .sb-desk {
      background-color: var(--bg-desk);
    }

    .sb-muted {
      color: var(--text-muted);
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Tekstur Kertas Partitur */
    .paper-classic {
      background-color: #ffffff;
      color: #0f172a;
    }
    .paper-ivory {
      background-color: #fdfbf7;
      color: #1c1917;
      background-image: radial-gradient(rgba(180, 140, 80, 0.08) 1px, transparent 0);
      background-size: 16px 16px;
    }
    .paper-manuscript {
      background-color: #f7f1e1;
      color: #292524;
      background-image: linear-gradient(to bottom, rgba(120, 90, 40, 0.06) 1px, transparent 1px);
      background-size: 100% 24px;
    }
    .paper-blueprint {
      background-color: #f0f9ff;
      color: #0c4a6e;
    }

    /* Kurung Sistem ala Sibelius */
    .system-bracket {
      position: relative;
      border-left: 3px solid #1e293b;
      padding-left: 10px;
    }
    .system-bracket::before,
    .system-bracket::after {
      content: '';
      position: absolute;
      left: -3px;
      width: 10px;
      height: 3px;
      background-color: #1e293b;
    }
    .system-bracket::before { top: 0; }
    .system-bracket::after { bottom: 0; }

    /* Garis Bendera Subdivisi Kepatihan */
    .beam-1 {
      border-top: 2px solid currentColor;
      padding-top: 2px;
    }
    .beam-2 {
      border-top: 2px solid currentColor;
      box-shadow: inset 0 2px 0 0 #ffffff, inset 0 4px 0 0 currentColor;
      padding-top: 5px;
    }
    .paper-ivory .beam-2 {
      box-shadow: inset 0 2px 0 0 #fdfbf7, inset 0 4px 0 0 currentColor;
    }
    .paper-manuscript .beam-2 {
      box-shadow: inset 0 2px 0 0 #f7f1e1, inset 0 4px 0 0 currentColor;
    }
    .paper-blueprint .beam-2 {
      box-shadow: inset 0 2px 0 0 #f0f9ff, inset 0 4px 0 0 currentColor;
    }

    /* Gaya Bilah Perunggu Virtual */
    .wilah-bar-wood {
      background: linear-gradient(180deg, #3b1d0e 0%, #241007 100%);
      border-top: 2px solid #92400e;
    }
    .wilah-key-bronze {
      background: linear-gradient(180deg, #fde68a 0%, #d97706 55%, #92400e 100%);
      color: #1c1917;
      border: 1px solid #fbbf24;
      box-shadow: 0 3px 0 #78350f, inset 0 1px 1px rgba(255,255,255,0.65);
      transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.1s ease;
    }
    .wilah-key-bronze:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #78350f, 0 0 14px rgba(251, 191, 36, 0.9);
      filter: brightness(1.18);
    }
    .wilah-key-pelog {
      background: linear-gradient(180deg, #fed7aa 0%, #ea580c 55%, #9a3412 100%);
      color: #fff7ed;
      border: 1px solid #fb923c;
      box-shadow: 0 3px 0 #7c2d12, inset 0 1px 1px rgba(255,255,255,0.45);
    }
    .wilah-key-pelog:active {
      transform: translateY(2px);
      filter: brightness(1.18);
    }
    .wilah-key-piano {
      background: linear-gradient(180deg, #ffffff 0%, #e2e8f0 100%);
      color: #0f172a;
      border: 1px solid #94a3b8;
      box-shadow: 0 3px 0 #64748b;
    }
    .wilah-key-piano:active {
      transform: translateY(2px);
      background: #bae6fd;
      box-shadow: 0 1px 0 #0284c7;
    }

    /* Responsif Floating Keypad untuk Mobile & Tablet */
    @media (max-width: 639px) {
      #floatingKeypad {
        position: fixed !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 24px !important;
        top: auto !important;
        width: 100% !important;
        max-width: 100% !important;
        border-radius: 16px 16px 0 0 !important;
      }
      #floatingKeypad.keypad-minimized .keypad-body {
        display: none !important;
      }
    }

    /* Mode Cetak / Simpan PDF Bersih */
    @media print {
      .no-print {
        display: none !important;
      }
      body, .sb-desk {
        background: #ffffff !important;
        color: #000000 !important;
        overflow: visible !important;
        height: auto !important;
      }
      #scoreScrollArea {
        overflow: visible !important;
        height: auto !important;
        padding: 0 !important;
      }
      #scorePaper {
        box-shadow: none !important;
        transform: none !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 12mm !important;
      }
    }
  </style>
</head>
<body class="theme-dark h-screen flex flex-col select-none overflow-hidden">

  <!-- ==================== TOP BAR & SIBELIUS RIBBON ==================== -->
  <header class="no-print sb-top border-b z-30 shrink-0">
    <!-- Baris Judul & Transport Utama -->
    <div class="px-2.5 sm:px-4 py-1.5 flex items-center justify-between gap-2 border-b border-slate-500/20">
      <div class="flex items-center gap-2 min-w-0">
        <button onclick="openQuickStart()" class="px-2.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center gap-1.5 shrink-0 shadow-sm transition" title="Buka Sibelius Quick Start">
          <i class="fa-solid fa-music"></i>
          <span class="hidden sm:inline">Quick Start</span>
        </button>

        <button onclick="toggleLeftDrawer()" class="lg:hidden px-2.5 py-1.5 rounded-lg sb-input border text-xs font-semibold flex items-center gap-1 shrink-0" title="Buka/Tutup Mixer & Inspektur">
          <i class="fa-solid fa-sliders text-amber-500"></i>
          <span class="hidden md:inline">Mixer</span>
        </button>

        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <h1 id="topDocTitle" class="font-bold text-xs sm:text-sm truncate">Lancaran Ricik-Ricik</h1>
            <span id="topModeBadge" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 shrink-0">Kepatihan • Slendro</span>
          </div>
          <p id="topSubInfo" class="text-[10px] sb-muted truncate hidden sm:block">Gaya Surakarta • 8 Gatra • ♩ = 84 BPM</p>
        </div>
      </div>

      <!-- Saklar Cepat Sistem Notasi (Gamelan vs Musik Barat) -->
      <div class="hidden md:flex items-center sb-input p-0.5 rounded-lg border text-[11px] font-bold shrink-0">
        <button id="btnSystemGamelan" onclick="setSystemMode('gamelan')" class="px-2.5 py-1 rounded-md bg-amber-500 text-slate-950 transition">
          Gamelan Jawa
        </button>
        <button id="btnSystemWestern" onclick="setSystemMode('western')" class="px-2.5 py-1 rounded-md sb-muted hover:text-amber-400 transition">
          Musik Barat
        </button>
      </div>

      <!-- Kontrol Transport Playback Sibelius -->
      <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
        <button id="btnPlayPause" onclick="togglePlayback()" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm transition" title="Putar / Jeda (Spasi)">
          <i id="playIcon" class="fa-solid fa-play"></i>
          <span id="playLabel" class="hidden sm:inline">Putar</span>
        </button>
        <button onclick="stopPlayback()" class="px-2.5 py-1.5 rounded-lg sb-input border hover:border-red-500 text-xs transition" title="Hentikan & Kembali ke Awal">
          <i class="fa-solid fa-stop text-red-400"></i>
        </button>
        <button id="btnHalfSpeed" onclick="toggleHalfSpeed()" class="hidden sm:inline-flex px-2 py-1.5 rounded-lg sb-input border text-[11px] font-bold transition" title="Latihan Setengah Kecepatan (0.5x)">
          0.5×
        </button>
        <button id="btnLoopGatra" onclick="toggleLoopGatra()" class="hidden md:inline-flex px-2 py-1.5 rounded-lg sb-input border text-xs transition" title="Ulangi Gatra Aktif (Loop)">
          <i class="fa-solid fa-repeat"></i>
        </button>
        <div class="hidden sm:flex items-center sb-input border rounded-lg px-2 py-1 gap-1">
          <span class="text-[10px] sb-muted font-bold">BPM</span>
          <input id="tempoInput" type="number" min="30" max="240" value="84" onchange="updateTempo(this.value)" class="w-11 bg-transparent text-xs font-bold text-center focus:outline-none" />
        </div>
      </div>

      <!-- Utilitas Kanan: Command Search, Tema, Simpan, Ekspor -->
      <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
        <button onclick="openCommandSearch()" class="px-2.5 py-1.5 rounded-lg sb-input border hover:border-amber-500 text-xs flex items-center gap-1.5 transition" title="Pencarian Perintah Sibelius (Ctrl+K)">
          <i class="fa-solid fa-magnifying-glass text-amber-500"></i>
          <span class="hidden xl:inline text-[11px] sb-muted">Cari (Ctrl+K)</span>
        </button>
        <button id="btnThemeToggle" onclick="cycleTheme()" class="px-2.5 py-1.5 rounded-lg sb-input border hover:border-amber-500 text-xs flex items-center gap-1 transition" title="Ganti Tema (Auto / Terang / Gelap)">
          <i id="themeIcon" class="fa-solid fa-circle-half-stroke text-amber-400"></i>
          <span id="themeLabel" class="hidden lg:inline text-[11px] font-semibold">Auto</span>
        </button>
        <button onclick="saveCurrentProject()" class="px-2.5 py-1.5 rounded-lg sb-input border hover:border-emerald-500 text-xs font-semibold flex items-center gap-1 transition" title="Simpan Versi Proyek (Ctrl+S)">
          <i class="fa-solid fa-floppy-disk text-emerald-400"></i>
          <span class="hidden md:inline">Simpan</span>
        </button>
        <button onclick="openModal('modalExport')" class="px-2.5 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs flex items-center gap-1 shadow-sm transition" title="Ekspor WAV, PNG, PDF, MIDI, JSON">
          <i class="fa-solid fa-file-export"></i>
          <span class="hidden sm:inline">Ekspor</span>
        </button>
      </div>
    </div>

    <!-- Tab Ribbon Sibelius -->
    <div class="px-2.5 sm:px-4 flex items-center justify-between border-b border-slate-500/20 overflow-x-auto no-scrollbar text-xs">
      <div class="flex items-center gap-1 py-1">
        <button data-ribbon-tab="file" onclick="switchRibbonTab('file')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">File</button>
        <button data-ribbon-tab="home" onclick="switchRibbonTab('home')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold bg-amber-500/20 text-amber-400 transition">Home</button>
        <button data-ribbon-tab="note" onclick="switchRibbonTab('note')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">Note Input</button>
        <button data-ribbon-tab="notations" onclick="switchRibbonTab('notations')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">Notations</button>
        <button data-ribbon-tab="text" onclick="switchRibbonTab('text')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">Text & Lirik</button>
        <button data-ribbon-tab="play" onclick="switchRibbonTab('play')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">Play</button>
        <button data-ribbon-tab="layout" onclick="switchRibbonTab('layout')" class="ribbon-tab-btn px-2.5 py-1 rounded-md font-bold transition">Layout</button>
      </div>

      <!-- Quick Mobile Mode Switcher -->
      <div class="flex md:hidden items-center gap-1 py-1 shrink-0">
        <button onclick="setSystemMode(state.systemMode === 'gamelan' ? 'western' : 'gamelan')" class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-bold text-[10px]">
          <i class="fa-solid fa-arrows-rotate mr-1"></i>Ganti Mode
        </button>
      </div>
    </div>

    <!-- Isi Toolbar Ribbon Aktif -->
    <div id="ribbonContent" class="px-2.5 sm:px-4 py-1.5 flex items-center gap-2 overflow-x-auto no-scrollbar text-xs sb-panel">
      <!-- Dirender dinamis oleh JS -->
    </div>
  </header>

  <!-- ==================== WORKSPACE UTAMA ==================== -->
  <div class="flex-1 flex overflow-hidden relative">

    <!-- PANEL KIRI: INSPEKTOR & MIXER PANGGUNG (Drawer di Mobile/Tablet, Fixed di Desktop) -->
    <aside id="leftSidebar" class="no-print sb-panel border-r w-72 sm:w-80 shrink-0 flex flex-col z-25 fixed lg:static inset-y-0 left-0 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 shadow-2xl lg:shadow-none">
      <div class="px-3 py-2 border-b border-slate-500/20 flex items-center justify-between">
        <span class="font-bold text-xs flex items-center gap-1.5">
          <i class="fa-solid fa-sliders text-amber-500"></i>
          <span>Inspektur & Mixer Panggung</span>
        </span>
        <button onclick="toggleLeftDrawer(false)" class="lg:hidden px-2 py-1 rounded sb-input text-xs">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-3 space-y-3 text-xs">
        <!-- Konfigurasi Gending / Lagu Aktif -->
        <div class="sb-card border rounded-xl p-2.5 space-y-2">
          <div class="font-bold text-[11px] uppercase tracking-wider text-amber-500 flex items-center justify-between">
            <span>Konfigurasi Partitur</span>
            <span id="inspectorGayaBadge" class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/15">Surakarta</span>
          </div>

          <div id="gamelanConfigGroup" class="grid grid-cols-2 gap-1.5">
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Gaya Tradisi</label>
              <select id="selectGaya" onchange="updateGaya(this.value)" class="w-full px-2 py-1 rounded sb-input border text-xs font-semibold">
                <option value="surakarta">Surakarta</option>
                <option value="yogyakarta">Yogyakarta</option>
                <option value="jawatimuran">Jawa Timuran</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Laras</label>
              <select id="selectLaras" onchange="updateLaras(this.value)" class="w-full px-2 py-1 rounded sb-input border text-xs font-semibold">
                <option value="slendro">Slendro</option>
                <option value="pelog">Pelog</option>
                <option value="gabungan">Gabungan (Sl+Pl)</option>
              </select>
            </div>
            <div class="col-span-2">
              <label class="text-[10px] sb-muted block mb-0.5">Bentuk Gending</label>
              <select id="selectGendingForm" onchange="updateGendingForm(this.value)" class="w-full px-2 py-1 rounded sb-input border text-xs font-semibold">
                <option value="lancaran">Lancaran (4 Ketuk/Gatra)</option>
                <option value="ketawang">Ketawang (16 Ketuk/Gongan)</option>
                <option value="ladrang">Ladrang (32 Ketuk/Gongan)</option>
                <option value="srepegan">Srepegan / Sampakan</option>
                <option value="bebas">Bentuk Bebas</option>
              </select>
            </div>
          </div>

          <div id="westernConfigGroup" class="hidden grid grid-cols-2 gap-1.5">
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Nada Dasar</label>
              <select id="selectWesternKey" onchange="updateWesternKey(this.value)" class="w-full px-2 py-1 rounded sb-input border text-xs font-semibold">
                <option value="Do = C">Do = C</option>
                <option value="Do = D">Do = D</option>
                <option value="Do = Eb">Do = Eb</option>
                <option value="Do = E">Do = E</option>
                <option value="Do = F">Do = F</option>
                <option value="Do = G">Do = G</option>
                <option value="Do = A">Do = A</option>
                <option value="Do = Bb">Do = Bb</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Birama</label>
              <select id="selectTimeSig" onchange="updateTimeSig(this.value)" class="w-full px-2 py-1 rounded sb-input border text-xs font-semibold">
                <option value="4">4/4 (4 Ketuk)</option>
                <option value="3">3/4 (3 Ketuk)</option>
                <option value="2">2/4 (2 Ketuk)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Navigator Mini-Map Gatra -->
        <div class="sb-card border rounded-xl p-2.5 space-y-1.5">
          <div class="font-bold text-[11px] uppercase tracking-wider text-sky-400 flex items-center justify-between">
            <span>Navigator Gatra / Birama</span>
            <span id="navTotalGatra" class="text-[10px] sb-muted">8 Gatra</span>
          </div>
          <div id="gatraNavigatorGrid" class="grid grid-cols-4 gap-1 max-h-28 overflow-y-auto">
            <!-- Dirender dinamis oleh JS -->
          </div>
        </div>

        <!-- Mixer & Panggung Stereo -->
        <div class="sb-card border rounded-xl p-2.5 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-[11px] uppercase tracking-wider text-emerald-400">Mixer & Panggung Stereo</span>
            <button onclick="openModal('modalAddTrack')" class="px-2 py-0.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px]">
              + Ricikan
            </button>
          </div>
          <div id="mixerTrackList" class="space-y-2">
            <!-- Dirender dinamis oleh JS -->
          </div>
        </div>

        <!-- Saran Cengkok & Harmoni AI Hibrida -->
        <div class="sb-card border rounded-xl p-2.5 space-y-2">
          <div class="font-bold text-[11px] uppercase tracking-wider text-purple-400 flex items-center justify-between">
            <span><i class="fa-solid fa-sparkles mr-1"></i>Saran Cengkok / Akor</span>
            <button onclick="generateSmartSuggestions()" class="text-[10px] underline hover:text-purple-300">Segarkan</button>
          </div>
          <div id="smartSuggestionsList" class="space-y-1.5">
            <!-- Dirender dinamis oleh JS -->
          </div>
        </div>
      </div>
    </aside>

    <!-- Backdrop Drawer untuk Mobile/Tablet -->
    <div id="leftDrawerBackdrop" onclick="toggleLeftDrawer(false)" class="no-print hidden fixed inset-0 bg-black/60 z-20 lg:hidden"></div>

    <!-- MEJA PARTITUR TENGAH (SIBELIUS DESK + DYNAMIC PART TABS) -->
    <main class="flex-1 flex flex-col overflow-hidden relative">
      <!-- Bilah Tab Dokumen: Full Score & Dynamic Parts -->
      <div class="no-print sb-top border-b px-2.5 sm:px-4 py-1 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar shrink-0">
        <div id="dynamicPartTabs" class="flex items-center gap-1">
          <!-- Tab Full Score + Dynamic Parts dirender dinamis -->
        </div>

        <div class="flex items-center gap-1.5 shrink-0 text-[11px]">
          <span id="reviewModeBadge" class="hidden px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 font-bold">
            <i class="fa-solid fa-lock mr-1"></i>Review Mode
          </span>
          <button onclick="togglePanoramaView()" id="btnPanorama" class="px-2 py-0.5 rounded sb-input border hover:border-amber-500 font-semibold" title="Alihkan Tampilan Halaman / Panorama (Shift+P)">
            <i class="fa-solid fa-arrows-left-right mr-1 text-amber-500"></i><span id="panoramaLabel">Halaman</span>
          </button>
        </div>
      </div>

      <!-- Area Gulir Kertas Partitur -->
      <div id="scoreScrollArea" class="flex-1 overflow-auto p-3 sm:p-6 md:p-8 flex justify-center items-start">
        <div id="scorePaper" class="paper-classic w-full max-w-4xl rounded-lg shadow-2xl p-5 sm:p-8 md:p-10 transition-all origin-top mb-56 sm:mb-24">
          <!-- Kop Judul Partitur -->
          <div class="border-b-2 border-slate-800 pb-3 mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span id="paperSystemTag" class="px-2 py-0.5 rounded bg-slate-900 text-amber-400 text-[10px] font-extrabold uppercase tracking-wider">
                  Notasi Kepatihan • Slendro • Surakarta
                </span>
                <span id="paperFormTag" class="px-2 py-0.5 rounded bg-slate-200 text-slate-800 text-[10px] font-bold uppercase">
                  Lancaran
                </span>
              </div>
              <h2 id="scoreHeaderTitle" contenteditable="true" onblur="updateScoreMeta('title', this.innerText)" class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight mt-1 outline-none focus:bg-amber-100/60 rounded px-1 -mx-1">
                Lancaran Ricik-Ricik
              </h2>
              <p id="scoreHeaderSubtitle" contenteditable="true" onblur="updateScoreMeta('subtitle', this.innerText)" class="text-xs sm:text-sm text-slate-600 font-medium outline-none focus:bg-amber-100/60 rounded px-1 -mx-1">
                Laras Slendro Pathet Manyura — Gaya Surakarta
              </p>
            </div>
            <div class="text-left sm:text-right shrink-0">
              <div id="scoreHeaderComposer" contenteditable="true" onblur="updateScoreMeta('composer', this.innerText)" class="text-xs font-bold text-slate-800 outline-none focus:bg-amber-100/60 rounded px-1">
                Penata: Karawitan Studio
              </div>
              <div id="scoreHeaderTempo" class="score-font text-xs font-extrabold text-slate-700 mt-0.5">
                ♩ = 84 (Irama Lancar)
              </div>
            </div>
          </div>

          <!-- Kontainer Sistem Baris Partitur -->
          <div id="scoreSystemsContainer" class="space-y-6">
            <!-- Sistem gatra/birama dirender oleh JS -->
          </div>

          <!-- Catatan Kaki Partitur -->
          <div class="mt-8 pt-3 border-t border-slate-300 flex flex-wrap items-center justify-between text-[10px] text-slate-500 gap-2">
            <span>Keterangan Kolotomik: ◯ Gong Ageng • ◌ Gong Suwukan • ◡ Kenong • ◠ Kempul • + Kethuk • - Kempyang</span>
            <span>Dicetak dari Kepatihan Studio</span>
          </div>
        </div>
      </div>

      <!-- ==================== FLOATING SIBELIUS KEYPAD ==================== -->
      <div id="floatingKeypad" class="no-print sb-panel border rounded-2xl shadow-2xl w-72 sm:w-80 fixed right-3 sm:right-5 bottom-8 z-30 overflow-hidden">
        <!-- Header Keypad (Bisa Digeser di Desktop/Tablet, Bisa Dilipat di Mobile) -->
        <div id="keypadDragHandle" class="sb-top px-3 py-2 border-b flex items-center justify-between cursor-move">
          <div class="flex items-center gap-1.5">
            <i class="fa-solid fa-grip-vertical sb-muted text-xs"></i>
            <span class="font-extrabold text-xs tracking-wide">Sibelius Keypad</span>
          </div>
          <div class="flex items-center gap-1">
            <button id="btnVoiceToggle" onclick="toggleActiveVoice()" class="px-2 py-0.5 rounded bg-sky-500/20 text-sky-400 font-bold text-[10px] transition" title="Pindah Lapisan Suara Atas/Bawah (Tombol V)">
              Suara 1 (Atas)
            </button>
            <button onclick="toggleKeypadMinimize()" class="sm:hidden px-2 py-0.5 rounded sb-input text-xs font-bold" title="Lipat / Buka Keypad">
              <i id="keypadMinIcon" class="fa-solid fa-chevron-down"></i>
            </button>
          </div>
        </div>

        <div class="keypad-body flex flex-col">
          <!-- Info Ketukan Aktif & Tombol Wilah Virtual -->
          <div class="px-3 py-1.5 sb-card border-b text-[10px] flex items-center justify-between gap-1">
            <span id="activeCellInfo" class="truncate font-semibold">Demung • Gatra 1 • Ketuk 1</span>
            <button onclick="toggleVirtualWilahBar()" class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 hover:bg-amber-500 hover:text-slate-950 font-bold text-[10px] shrink-0 transition" title="Buka/Tutup Bilah Wilah Virtual (Ctrl+Alt+K)">
              <i class="fa-solid fa-bars-staggered mr-1"></i>Wilah
            </button>
          </div>

          <!-- Bilah Aksi Cepat (Undo, Auto-Garap, Jenjang Irama) -->
          <div class="px-2.5 py-1.5 border-b border-slate-500/20 flex items-center gap-1 overflow-x-auto no-scrollbar text-[10px]">
            <button onclick="undoLastAction()" class="px-2 py-1 rounded sb-input border hover:border-amber-500 font-bold shrink-0" title="Undo (Ctrl+Z)">
              <i class="fa-solid fa-rotate-left text-amber-500"></i>
            </button>
            <button onclick="openModal('modalAutoGarap')" class="px-2 py-1 rounded bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600 hover:text-white border border-emerald-500/30 font-bold shrink-0 transition" title="Auto-Garap Karawitan dari Balungan">
              <i class="fa-solid fa-wand-magic-sparkles mr-1"></i>Auto-Garap
            </button>
            <select id="quickIramaSelect" onchange="setIramaLevel(this.value)" class="px-1.5 py-1 rounded sb-input border text-[10px] font-semibold shrink-0" title="Jenjang Irama Karawitan">
              <option value="lancar" selected>Irama I (Lancar)</option>
              <option value="tanggung">Irama II (Tanggung)</option>
              <option value="dados">Irama III (Dados)</option>
              <option value="wiled">Irama IV (Wiled)</option>
            </select>
          </div>

          <!-- Subdivisi & Oktaf -->
          <div class="p-2.5 space-y-2">
            <div class="grid grid-cols-4 gap-1 text-[11px] font-bold">
              <button data-subdiv="1" onclick="setCellSubdivision(1)" class="subdiv-btn py-1.5 rounded-lg bg-amber-500 text-slate-950 transition">1 Ketuk</button>
              <button data-subdiv="2" onclick="setCellSubdivision(2)" class="subdiv-btn py-1.5 rounded-lg sb-input border transition">½ (2)</button>
              <button data-subdiv="3" onclick="setCellSubdivision(3)" class="subdiv-btn py-1.5 rounded-lg sb-input border transition">Triol (3)</button>
              <button data-subdiv="4" onclick="setCellSubdivision(4)" class="subdiv-btn py-1.5 rounded-lg sb-input border transition">¼ (4)</button>
            </div>

            <!-- Pemilih Sub-Ketukan jika subdivisi > 1 -->
            <div id="subBeatSelectorRow" class="hidden flex items-center justify-between gap-1 sb-card px-2 py-1 rounded-lg border text-[10px]">
              <span class="sb-muted font-bold">Posisi Sub-Ketuk:</span>
              <div id="subBeatButtons" class="flex items-center gap-1"></div>
            </div>

            <!-- Oktaf & Harmoni Vertikal -->
            <div class="grid grid-cols-4 gap-1 text-[11px] font-bold">
              <button onclick="shiftNoteOctave(-1)" class="py-1.5 rounded-lg sb-input border hover:border-amber-500 transition" title="Titik Bawah / Turun Oktaf">Oktaf -</button>
              <button onclick="shiftNoteOctave(1)" class="py-1.5 rounded-lg sb-input border hover:border-amber-500 transition" title="Titik Atas / Naik Oktaf">Oktaf +</button>
              <button onclick="applyVerticalInterval('gembyang')" class="py-1.5 rounded-lg sb-input border hover:border-sky-400 text-sky-400 transition" title="Tambah Suara 2 Gembyang (Oktaf)">Gembyang</button>
              <button onclick="applyVerticalInterval('kempyung')" class="py-1.5 rounded-lg sb-input border hover:border-purple-400 text-purple-400 transition" title="Tambah Suara 2 Kempyung">Kempyung</button>
            </div>

            <!-- Grid Tombol Angka Dinamis (Slendro / Pelog / Gabungan / Kendhang / Barat) -->
            <div id="keypadNotesContainer" class="space-y-1.5">
              <!-- Dirender dinamis oleh JS -->
            </div>

            <!-- Input Lirik / Cakepan Ketukan Aktif -->
            <div class="pt-1 border-t border-slate-500/20 flex items-center gap-1.5">
              <span id="lyricVerseLabel" class="text-[10px] font-bold text-amber-500 shrink-0">Ayat 1:</span>
              <input id="inputBeatLyric" type="text" placeholder="Suku kata cakepan/lirik..." oninput="updateCurrentCellLyric(this.value)" class="flex-1 px-2 py-1 rounded sb-input border text-xs focus:outline-none focus:border-amber-500" />
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== VIRTUAL WILAH PERUNGGU / PIANO AUDISI ==================== -->
      <div id="virtualWilahBar" class="no-print hidden fixed bottom-6 left-0 right-0 z-30 wilah-bar-wood px-2.5 sm:px-4 py-2 shadow-2xl">
        <div class="max-w-5xl mx-auto flex flex-col gap-1.5">
          <div class="flex items-center justify-between text-[10px] text-amber-200">
            <div class="flex items-center gap-2">
              <span class="font-bold tracking-wide uppercase">
                <i class="fa-solid fa-drum-steelpan text-amber-400 mr-1"></i>
                <span id="wilahBarTitle">Rancakan Wilah Perunggu (Slendro)</span>
              </span>
              <span class="hidden sm:inline text-amber-300/75">• Ketuk bilah untuk audisi & input nada langsung</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button id="btnWilahStepMode" onclick="toggleWilahStepInput()" class="px-2 py-0.5 rounded bg-emerald-600 text-white font-bold text-[9px] transition">
                Mode: Rekam Step-Time
              </button>
              <button onclick="toggleVirtualWilahBar(false)" class="px-2 py-0.5 rounded bg-black/40 hover:bg-black/70 text-amber-200 text-xs">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          </div>
          <div id="virtualWilahKeys" class="grid grid-cols-6 sm:grid-cols-12 gap-1 sm:gap-1.5">
            <!-- Dirender dinamis oleh JS -->
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- ==================== STATUS BAR BAWAH ALA SIBELIUS ==================== -->
  <footer class="no-print sb-top border-t px-3 py-1 flex items-center justify-between text-[10px] sb-muted shrink-0 z-30">
    <div class="flex items-center gap-3 truncate">
      <span id="statusReadyText" class="font-semibold text-emerald-400"><i class="fa-solid fa-circle text-[7px] mr-1"></i>Siap</span>
      <span id="statusCursorInfo" class="truncate">Instrumen: Demung • Gatra 1 • Ketuk 1 • Suara 1</span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button onclick="changeZoom(-0.1)" class="hover:text-amber-400 px-1" title="Perkecil Kertas"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
      <span id="zoomLabel" class="font-bold score-font">100%</span>
      <button onclick="changeZoom(0.1)" class="hover:text-amber-400 px-1" title="Perbesar Kertas"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
    </div>
  </footer>

  <!-- ==================== MODAL 1: SIBELIUS QUICK START ==================== -->
  <div id="quickStartModal" class="no-print fixed inset-0 bg-black/75 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-5">
    <div class="sb-panel border rounded-2xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="sb-top px-4 sm:px-6 py-3.5 border-b flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-extrabold text-sm">
            <i class="fa-solid fa-music"></i>
          </div>
          <div>
            <h2 class="font-extrabold text-sm sm:text-base">Kepatihan Studio — Sibelius Quick Start</h2>
            <p class="text-[11px] sb-muted">Pilih templat gending Jawa, partitur musik Barat, atau lanjutkan proyek tersimpan</p>
          </div>
        </div>
        <button onclick="closeQuickStart()" class="px-3 py-1.5 rounded-lg sb-input border hover:border-amber-500 text-xs font-bold">
          Tutup <i class="fa-solid fa-xmark ml-1"></i>
        </button>
      </div>

      <!-- Tab Quick Start -->
      <div class="px-4 sm:px-6 pt-2 border-b border-slate-500/20 flex items-center gap-2 text-xs font-bold">
        <button id="qsTabTemplates" onclick="switchQuickStartTab('templates')" class="px-3 py-2 border-b-2 border-amber-500 text-amber-400">Templat & Setup Baru</button>
        <button id="qsTabSaved" onclick="switchQuickStartTab('saved')" class="px-3 py-2 border-b-2 border-transparent sb-muted">Proyek Tersimpan & Versi</button>
        <button id="qsTabGuide" onclick="switchQuickStartTab('guide')" class="px-3 py-2 border-b-2 border-transparent sb-muted">Panduan & Pintasan</button>
      </div>

      <div class="flex-1 overflow-y-auto p-4 sm:p-6">
        <!-- Tab 1: Templates & Setup -->
        <div id="qsBodyTemplates" class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="lg:col-span-2 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-amber-500">Pilih Templat Bawaan</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <button onclick="loadPresetAndClose('ricik_slendro')" class="sb-card border hover:border-amber-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-amber-400">Lancaran Ricik-Ricik</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">Slendro</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Gaya Surakarta • Full Ricikan (Demung, Saron, Peking, Slenthem, Bonang, Kendhang, Gong)</p>
              </button>

              <button onclick="loadPresetAndClose('puspawarna')" class="sb-card border hover:border-amber-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-emerald-400">Ketawang Puspawarna</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">Slendro</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Gaya Surakarta • Lengkap dengan Cakepan Vokal & Penanda Kenong/Gong</p>
              </button>

              <button onclick="loadPresetAndClose('wilujeng_pelog')" class="sb-card border hover:border-amber-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-orange-400">Ladrang Wilujeng</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 font-bold">Pelog Barang</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Gaya Yogyakarta • Susunan Balungan & Kendhang Satunggal</p>
              </button>

              <button onclick="loadPresetAndClose('jatim_slendro')" class="sb-card border hover:border-amber-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-rose-400">Lancaran Gula Klapa</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-bold">Jawa Timuran</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Embat Jawi Wetanan • Ritme Enerjik & Kendhang Ngremo</p>
              </button>

              <button onclick="loadPresetAndClose('gabungan_campursari')" class="sb-card border hover:border-amber-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-purple-400">Karya Gabungan Slendro-Pelog</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-bold">Gabungan</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Transisi laras Slendro (1 2 3 5 6) & Pelog (4 7) dalam satu partitur</p>
              </button>

              <button onclick="loadPresetAndClose('western_choir')" class="sb-card border hover:border-sky-500 rounded-xl p-3 text-left transition">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-sky-400">Not Angka Musik Barat</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 font-bold">Do = C • 4/4</span>
                </div>
                <p class="text-[11px] sb-muted mt-1">Melodi Utama, Harmoni Vokal, Bass, & Piano dengan tanda kromatik</p>
              </button>
            </div>
          </div>

          <!-- Form Buat Partitur Kosong Kustom -->
          <div class="sb-card border rounded-xl p-3.5 space-y-2.5 text-xs">
            <div class="font-bold uppercase tracking-wider text-sky-400">Buat Lembar Kosong Baru</div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Judul Gending / Lagu</label>
              <input id="qsNewTitle" type="text" value="Gending Baru" class="w-full px-2.5 py-1.5 rounded sb-input border text-xs font-semibold" />
            </div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Penata / Komposer</label>
              <input id="qsNewComposer" type="text" value="Penata Karawitan" class="w-full px-2.5 py-1.5 rounded sb-input border text-xs" />
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="text-[10px] sb-muted block mb-0.5">Sistem</label>
                <select id="qsNewSystem" class="w-full px-2 py-1.5 rounded sb-input border text-xs font-semibold">
                  <option value="gamelan">Gamelan Jawa</option>
                  <option value="western">Musik Barat</option>
                </select>
              </div>
              <div>
                <label class="text-[10px] sb-muted block mb-0.5">Jumlah Gatra</label>
                <input id="qsNewMeasures" type="number" min="2" max="64" value="8" class="w-full px-2 py-1.5 rounded sb-input border text-xs font-bold" />
              </div>
            </div>
            <button onclick="createBlankScoreFromQS()" class="w-full py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs shadow transition">
              Mulai Menulis Partitur
            </button>
          </div>
        </div>

        <!-- Tab 2: Saved Projects & Versions -->
        <div id="qsBodySaved" class="hidden space-y-3 text-xs">
          <div class="flex items-center justify-between">
            <span class="font-bold uppercase tracking-wider text-emerald-400">Riwayat Simpan & Versi Partitur</span>
            <label class="px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-bold cursor-pointer">
              <i class="fa-solid fa-folder-open mr-1"></i>Impor File .JSON
              <input type="file" accept=".json" onchange="importProjectJson(event)" class="hidden" />
            </label>
          </div>
          <div id="savedProjectsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- Dirender dinamis oleh JS -->
          </div>
        </div>

        <!-- Tab 3: Guide & Shortcuts -->
        <div id="qsBodyGuide" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="sb-card border rounded-xl p-3 space-y-1.5">
            <div class="font-bold text-amber-400">Pintasan Keyboard Sibelius</div>
            <ul class="space-y-1 text-[11px] sb-muted">
              <li><strong class="text-amber-300">1 – 7:</strong> Masukkan nada & maju otomatis</li>
              <li><strong class="text-amber-300">. (Titik) / 0:</strong> Pin (perpanjang) / Diam</li>
              <li><strong class="text-amber-300">Panah Atas/Bawah/Kiri/Kanan:</strong> Navigasi kursor</li>
              <li><strong class="text-amber-300">Spasi:</strong> Putar / Jeda Playback</li>
              <li><strong class="text-amber-300">V:</strong> Pindah Suara 1 (Atas) / Suara 2 (Bawah)</li>
              <li><strong class="text-amber-300">Ctrl+Z:</strong> Undo langkah terakhir</li>
              <li><strong class="text-amber-300">Ctrl+S / Ctrl+K:</strong> Simpan / Command Search</li>
              <li><strong class="text-amber-300">Ctrl+Alt+K:</strong> Buka Rancakan Wilah Virtual</li>
            </ul>
          </div>
          <div class="sb-card border rounded-xl p-3 space-y-1.5">
            <div class="font-bold text-emerald-400">Panduan GitHub Pages & PWA</div>
            <p class="text-[11px] sb-muted leading-relaxed">
              Simpan file ini sebagai <code class="text-amber-300">index.html</code> di repositori GitHub Anda, lalu aktifkan <strong>Settings → Pages</strong>. Website langsung dapat diakses online maupun di-install sebagai aplikasi di Windows, Mac, Android, dan iPhone/iPad.
            </p>
            <p class="text-[11px] sb-muted leading-relaxed">
              Untuk memakai rekaman audio asli milik Anda sendiri (`.wav`/`.mp3`), buka menu <strong>File → Sampel Audio Kustom</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== MODAL 2: COMMAND SEARCH (CTRL+K) ==================== -->
  <div id="modalCommandSearch" class="no-print hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-start justify-center pt-16 p-4">
    <div class="sb-panel border rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden">
      <div class="p-3 border-b border-slate-500/20 flex items-center gap-2">
        <i class="fa-solid fa-magnifying-glass text-amber-500"></i>
        <input id="commandSearchInput" type="text" placeholder="Ketik perintah Sibelius (misal: Gembyang, WAV, Panorama, Wilah)..." oninput="filterCommandSearch(this.value)" class="flex-1 bg-transparent text-xs sm:text-sm focus:outline-none" />
        <button onclick="closeModal('modalCommandSearch')" class="text-xs sb-muted hover:text-amber-400 px-2 py-1">ESC</button>
      </div>
      <div id="commandSearchResults" class="max-h-72 overflow-y-auto p-2 space-y-1 text-xs">
        <!-- Dirender dinamis -->
      </div>
    </div>
  </div>

  <!-- ==================== MODAL 3: AUTO-GARAP KARAWITAN ==================== -->
  <div id="modalAutoGarap" class="no-print hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="sb-panel border rounded-2xl max-w-md w-full shadow-2xl overflow-hidden">
      <div class="sb-top px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-bold text-sm flex items-center gap-2">
          <i class="fa-solid fa-wand-magic-sparkles text-emerald-400"></i>
          <span>Auto-Garap Karawitan & Kolotomik</span>
        </h3>
        <button onclick="closeModal('modalAutoGarap')" class="sb-muted hover:text-amber-400 px-2 py-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="p-4 space-y-2.5 text-xs">
        <p class="sb-muted text-[11px] leading-relaxed">
          Menyusun isian ricikan pengiring dan penanda struktural secara otomatis berdasarkan alur <strong>Balungan</strong> yang sudah ditulis (ala <em>Sibelius Arrange</em>):
        </p>
        <button onclick="autoGarapFromBalungan('kolotomik')" class="w-full p-3 rounded-xl sb-card border hover:border-amber-500 text-left transition flex items-center justify-between">
          <div>
            <div class="font-bold text-amber-400">1. Penanda Struktural (Gong, Kenong, Kempul, Kethuk)</div>
            <div class="text-[11px] sb-muted mt-0.5">Mengisi ◯, ◡, ◠, +, - sesuai bentuk gending aktif</div>
          </div>
          <i class="fa-solid fa-chevron-right sb-muted"></i>
        </button>
        <button onclick="autoGarapFromBalungan('peking')" class="w-full p-3 rounded-xl sb-card border hover:border-amber-500 text-left transition flex items-center justify-between">
          <div>
            <div class="font-bold text-sky-400">2. Garap Peking / Saron Panerus (Nacah 2×)</div>
            <div class="text-[11px] sb-muted mt-0.5">Memecah tiap nada balungan menjadi pukulan ganda ½ ketuk</div>
          </div>
          <i class="fa-solid fa-chevron-right sb-muted"></i>
        </button>
        <button onclick="autoGarapFromBalungan('slenthem')" class="w-full p-3 rounded-xl sb-card border hover:border-amber-500 text-left transition flex items-center justify-between">
          <div>
            <div class="font-bold text-emerald-400">3. Garap Slenthem (Balungan Oktaf Rendah)</div>
            <div class="text-[11px] sb-muted mt-0.5">Menyalin melodi balungan ke register rendah dengan titik bawah (•)</div>
          </div>
          <i class="fa-solid fa-chevron-right sb-muted"></i>
        </button>
        <button onclick="autoGarapFromBalungan('bonang')" class="w-full p-3 rounded-xl sb-card border hover:border-amber-500 text-left transition flex items-center justify-between">
          <div>
            <div class="font-bold text-purple-400">4. Garap Bonang Barung (Gembyang Oktaf)</div>
            <div class="text-[11px] sb-muted mt-0.5">Menyusun pola gembyang (Suara 1 + Suara 2) dari balungan</div>
          </div>
          <i class="fa-solid fa-chevron-right sb-muted"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== MODAL 4: MANAJER SAMPEL AUDIO KUSTOM ==================== -->
  <div id="modalSamples" class="no-print hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="sb-panel border rounded-2xl max-w-xl w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="sb-top px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-bold text-sm flex items-center gap-2">
          <i class="fa-solid fa-wave-square text-amber-500"></i>
          <span>Manajer Sampel Audio & Kode GitHub</span>
        </h3>
        <button onclick="closeModal('modalSamples')" class="sb-muted hover:text-amber-400 px-2 py-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto p-4 space-y-3 text-xs">
        <p class="sb-muted text-[11px] leading-relaxed">
          Unggah rekaman suara asli milik Anda (<code class="text-amber-400">.wav</code> / <code class="text-amber-400">.mp3</code> / <code class="text-amber-400">.ogg</code>) untuk menggantikan suara sintesis bawaan. Anda juga bisa mengunduh file pemetaan kode <code class="text-emerald-400">samples-map.js</code> untuk ditaruh di repositori GitHub Anda.
        </p>

        <div class="sb-card border rounded-xl p-3 space-y-2">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Pilih Instrumen</label>
              <select id="sampleTrackSelect" class="w-full px-2 py-1.5 rounded sb-input border text-xs font-semibold"></select>
            </div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">Nada / Pukulan</label>
              <select id="samplePitchSelect" class="w-full px-2 py-1.5 rounded sb-input border text-xs font-semibold">
                <option value="1">Nada 1 (Ji / Do)</option>
                <option value="2">Nada 2 (Ro / Re)</option>
                <option value="3">Nada 3 (Lu / Mi)</option>
                <option value="4">Nada 4 (Pat / Fa)</option>
                <option value="5">Nada 5 (Ma / Sol)</option>
                <option value="6">Nada 6 (Nem / La)</option>
                <option value="7">Nada 7 (Pi / Si)</option>
                <option value="P">Kendhang P (Thung)</option>
                <option value="b">Kendhang b (Dhang)</option>
                <option value="t">Kendhang t (Tak)</option>
                <option value="◯">Gong Ageng (◯)</option>
                <option value="◡">Kenong (◡)</option>
                <option value="◠">Kempul (◠)</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] sb-muted block mb-0.5">File Audio Rekaman</label>
              <label class="w-full py-1.5 px-2 rounded bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-center block cursor-pointer">
                <i class="fa-solid fa-upload mr-1"></i>Pilih File
                <input type="file" accept="audio/*" onchange="handleCustomSampleUpload(event)" class="hidden" />
              </label>
            </div>
          </div>
        </div>

        <div id="customSamplesList" class="space-y-1.5">
          <!-- Daftar sampel terpasang -->
        </div>

        <div class="pt-2 border-t border-slate-500/20 flex justify-between items-center">
          <span class="text-[11px] sb-muted">Siap untuk di-commit ke GitHub Pages:</span>
          <button onclick="downloadGitHubSamplesConfig()" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold">
            <i class="fa-solid fa-code mr-1"></i>Unduh samples-map.js
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== MODAL 5: EKSPOR LENGKAP ==================== -->
  <div id="modalExport" class="no-print hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="sb-panel border rounded-2xl max-w-md w-full shadow-2xl overflow-hidden">
      <div class="sb-top px-4 py-3 border-b flex items-center justify-between">
